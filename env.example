# Copy this file to .env for local testing only.
# In production these are set as GitHub Actions secrets (see setup guide) -
# never commit a real .env file.

SHEET_ID=your_google_sheet_id_here
GOOGLE_CLIENT_EMAIL=dashboard-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
ANTHROPIC_API_KEY=sk-ant-...

# Max product rows to process in a single run of this script.
# The GitHub Action schedule + this cap together control your daily total.
BATCH_SIZE=10

# Hard ceiling on rows processed per calendar day (script checks the
# "Processed Date" column against today's date to enforce this).
DAILY_CAP=100
